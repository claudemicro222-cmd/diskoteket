<?xml version="1.0"?>
<Container version="2">
  <Name>Diskoteket</Name>
  <Repository>ghcr.io/claudemicro222-cmd/diskoteket:latest</Repository>
  <Registry>https://github.com/claudemicro222-cmd/diskoteket/pkgs/container/diskoteket</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/claudemicro222-cmd/diskoteket/issues</Support>
  <Project>https://github.com/claudemicro222-cmd/diskoteket</Project>
  <Overview>Your own movie, TV series and music collection. Mobile-friendly web app with barcode scanning, multiple collections, import from CLZ Movies and CLZ Music, covers from TMDB and MusicBrainz, loans, statistics, optional login and integration with Plex/Jellyfin and Home Assistant. Everything is stored in appdata. English and Swedish. NOTE: vibe-coded – all code is written by Claude (AI), not by a professional developer.</Overview>
  <Category>MediaApp:Video MediaApp:Music Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/claudemicro222-cmd/diskoteket/main/unraid/diskoteket.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/claudemicro222-cmd/diskoteket/main/unraid/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web page (port)" Target="8080" Default="8080" Mode="tcp" Description="The port you reach Diskoteket on, e.g. http://tower:8080" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/diskoteket" Mode="rw" Description="Database, covers, backups and settings" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/diskoteket</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID (Unraid: 99 = nobody)" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID (Unraid: 100 = users)" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="002" Mode="" Description="File permissions for new files" Type="Variable" Display="advanced" Required="false" Mask="false">002</Config>
  <Config Name="Time zone" Target="TZ" Default="Europe/Stockholm" Mode="" Description="Time zone for dates and backups" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Stockholm</Config>
</Container>
