<?xml version="1.0"?>
<Container version="2">
  <Name>Diskoteket</Name>
  <Repository>ghcr.io/claudemicro222-cmd/diskoteket:latest</Repository>
  <Registry>https://github.com/claudemicro222-cmd/diskoteket/pkgs/container/diskoteket</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/claudemicro222-cmd/diskoteket/issues</Support>
  <Project>https://github.com/claudemicro222-cmd/diskoteket</Project>
  <Overview>Egen film-, serie- och musiksamling. Mobilanpassad webbsida med streckkodsskanning, flera samlingar, import från CLZ Movies och CLZ Music, omslag från TMDB och MusicBrainz, utlåning, statistik, valfri inloggning och koppling till Plex/Jellyfin och Home Assistant. Allt sparas i appdata. OBS: vibecodat – all kod är skriven av Claude (AI), inte av en professionell utvecklare.</Overview>
  <Category>MediaApp:Video MediaApp:Music Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/claudemicro222-cmd/diskoteket/main/unraid/diskoteket.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/claudemicro222-cmd/diskoteket/main/unraid/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Webbsida (port)" Target="8080" Default="8080" Mode="tcp" Description="Porten du når Diskoteket på, t.ex. http://tower:8080" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/diskoteket" Mode="rw" Description="Databas, omslag, säkerhetskopior och inställningar" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/diskoteket</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Användar-ID (Unraid: 99 = nobody)" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Grupp-ID (Unraid: 100 = users)" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="002" Mode="" Description="Filrättigheter för nya filer" Type="Variable" Display="advanced" Required="false" Mask="false">002</Config>
  <Config Name="Tidszon" Target="TZ" Default="Europe/Stockholm" Mode="" Description="Tidszon för datum och säkerhetskopior" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Stockholm</Config>
</Container>
